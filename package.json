{
  "name": "ta-queue-platform",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo dev --filter=@ta/web --filter=@ta/bot --filter=@ta/worker",
    "build": "turbo build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema packages/database/prisma/schema.prisma",
    "db:seed": "tsx packages/database/src/seed.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "web": "tsx scripts/web.ts dev",
    "bot": "tsx apps/bot/src/index.ts",
    "worker": "tsx apps/worker/src/index.ts",
    "test:e2e": "python3 tests/e2e.py",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "start": "tsx scripts/web.ts start",
    "ops": "tsx apps/ops-agent/src/index.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.2.8",
    "@fontsource/ibm-plex-sans": "5.2.8",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-popover": "1.1.15",
    "@tanstack/react-query": "5.90.21",
    "argon2": "0.44.0",
    "bullmq": "5.71.0",
    "csv-parse": "7.0.2",
    "csv-stringify": "6.6.0",
    "discord.js": "14.27.0",
    "dotenv": "16.6.1",
    "ioredis": "5.9.3",
    "lucide-react": "0.577.0",
    "next": "16.4.0",
    "pino": "10.3.1",
    "react": "19.2.4",
    "react-colorful": "5.6.1",
    "react-dom": "19.2.4",
    "recharts": "3.8.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.0",
    "prettier": "3.8.1",
    "prisma": "6.19.3",
    "tsx": "4.21.0",
    "turbo": "2.8.17",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "argon2",
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "sharp": "0.35.5",
      "deepmerge-ts": "8.0.2",
      "uuid": "11.1.1"
    }
  }
}
