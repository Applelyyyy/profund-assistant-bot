# Copy to root .env. Docker Compose is the deployment authority.
# Quote secrets containing $ or # with single quotes, e.g. 'my$secret#value'.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_MESSAGE_CONTENT_ENABLED=false

# Used only if no administrator exists; changing these does not reset an account.
ADMIN_BOOTSTRAP_USERNAME=admin
# 14–256 characters. Never printed in logs.
ADMIN_BOOTSTRAP_PASSWORD=
AUTH_SECRET=

# Host binding and browser origin (protocol, hostname and port must match).
WEB_HOST=127.0.0.1
WEB_PORT=3000
APP_BASE_URL=http://127.0.0.1:3000

POSTGRES_USER=ta
POSTGRES_PASSWORD=
POSTGRES_DB=ta_queue
REDIS_PASSWORD=

NODE_ENV=production
LOG_LEVEL=info
TZ=Asia/Bangkok

# Image user IDs. Keep these stable when reusing existing log volumes.
APP_UID=1000
APP_GID=1000

# Optional contributor tools only; Docker constructs its own internal URLs.
# DATABASE_URL=postgresql://ta:password@127.0.0.1:5432/ta_queue
# REDIS_URL=redis://:password@127.0.0.1:6379
# TEST_DATABASE_URL=postgresql://ta:password@127.0.0.1:5432/ta_queue_test
# TIMEZONE=Asia/Bangkok
# SERVICE_CONTROL_ENABLED=false

# Optional bounded, redacted latency/runtime summaries every 60 seconds
PERFORMANCE_METRICS_ENABLED=false
